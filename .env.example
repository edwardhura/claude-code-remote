# Claude Code Remote — environment template.
# Copy to `.env` and fill in. `install.sh` will generate JWT_SECRET if blank.

# Required
TELEGRAM_BOT_TOKEN=123456:ABCdef...           # from @BotFather
PUBLIC_URL=https://my-machine.tail-scale.ts.net  # base URL exposed by your tunnel
JWT_SECRET=                                    # 32+ random bytes; install.sh generates if blank

# Optional (sensible defaults)
WEB_HOST=127.0.0.1
WEB_PORT=8765
TOKEN_TTL_SECONDS=1800                         # 30 min
COOKIE_TTL_SECONDS=1800                        # 30 min
DATA_DIR=./data
CLAUDE_BIN=claude
CLAUDE_EXTRA_ARGS=
LOG_RETENTION_COUNT=200
LOG_RETENTION_DAYS=30
LOG_LEVEL=INFO
PAIRING_CODE_TTL_SECONDS=900
SUBPROCESS_GRACE_KILL_SECONDS=5
MCP_PERMISSION_TIMEOUT_SECONDS=120             # seconds the MCP permission tool waits for a chat decision

# Permission / tool gating (CCR-029)
# Set DISALLOWED_TOOLS to force common tool calls through the MCP permission
# prompt (CCR-025/CCR-028). Reads stay frictionless; Write/Edit/Bash prompt.
PERMISSION_MODE=                               # blank = default (auto-allow); "acceptEdits", "plan", "bypassPermissions"
ALLOWED_TOOLS=                                 # comma-separated; mutually exclusive with DISALLOWED_TOOLS
DISALLOWED_TOOLS=                              # e.g. Write,Edit,Bash — forces those tools through the MCP permission path

PROXY_PORT_ALLOWLIST=                          # blank = any local port; "3000,5173" to restrict
